    "    \"    image_embeddings = []\\n\",\n",
    "    \"    text_embeddings = []\\n\",\n",
    "    \"    recipe_entries = []\\n\",\n",
    "    \"    image_ids = []\\n\",\n",
    "    \"    gt_indices = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for batch_idx, (images, tokens) in enumerate(tqdm(eval_loader, desc=\\\"Encoding\\\")):\\n\",\n",
    "    \"        images, tokens = images.cuda(), tokens.cuda()\\n\",\n",
    "    \"        img_emb = image_encoder(images)\\n\",\n",
    "    \"        if model_mode == \\\"joint\\\":\\n\",\n",
    "    \"            txt_emb = text_encoder(img_emb, tokens)\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            txt_emb = text_encoder(tokens)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        image_embeddings.append(img_emb)\\n\",\n",
    "    \"        text_embeddings.append(txt_emb)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for i in range(images.size(0)):\\n\",\n",
    "    \"            entry = eval_dataset.data[batch_idx * eval_loader.batch_size + i]\\n\",\n",
    "    \"            recipe_entries.append(entry)\\n\",\n",
    "    \"            image_ids.append(entry[\\\"image\\\"])\\n\",\n",
    "    \"            gt_indices.append(batch_idx * eval_loader.batch_size + i)  # assuming aligned order\\n\",\n",
    "    \"\\n\",\n",
    "    \"    image_embeddings = torch.cat(image_embeddings, dim=0)\\n\",\n",
    "    \"    text_embeddings = torch.cat(text_embeddings, dim=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sims = image_embeddings @ text_embeddings.T\\n\",\n",
    "    \"    values, indices = torch.topk(sims, k=topk, dim=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results = []\\n\",\n",
    "    \"    failures = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i, (img_id, top_idx, gt_idx) in enumerate(zip(image_ids, indices, gt_indices)):\\n\",\n",
    "    \"        top_recipes = [recipe_entries[j] for j in top_idx.tolist()]\\n\",\n",
    "    \"        hit = gt_idx in top_idx.tolist()\\n\",\n",
    "    \"        entry = {\\n\",\n",
    "    \"            \\\"query_image\\\": img_id,\\n\",\n",
    "    \"            \\\"top_recipes\\\": top_recipes,\\n\",\n",
    "    \"            \\\"match_found\\\": hit,\\n\",\n",
    "    \"            \\\"ground_truth_idx\\\": gt_idx,\\n\",\n",
    "    \"            \\\"retrieved_indices\\\": top_idx.tolist()\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"        results.append(entry)\\n\",\n",
    "    \"        if not hit:\\n\",\n",
    "    \"            failures.append(entry)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with open(outfile, \\\"w\\\") as f:\\n\",\n",
    "    \"        json.dump(results, f, indent=2)\\n\",\n",
    "    \"    print(f\\\"Saved retrieval results to {outfile}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if save_failures_only:\\n\",\n",
    "    \"        with open(failure_output, \\\"w\\\") as f:\\n\",\n",
    "    \"            json.dump(failures, f, indent=2)\\n\",\n",
    "    \"        print(f\\\"Saved {len(failures)} failures to {failure_output}\\\")\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"225ae6e5\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from multimodal_encoder import ImageEncoder, JointEncoderWithCrossAttention, TransformerEncoder\\n\",\n",
    "    \"from torch.utils.data import DataLoader\\n\",\n",
    "    \"from torchvision import transforms\\n\",\n",
    "    \"import torch, pickle, json\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Config\\n\",\n",
    "    \"MODE = \\\"joint\\\"\\n\",\n",
    "    \"VAL_JSON = \\\"data/mini_data_val/val_recipes_stratified.json\\\"\\n\",\n",
    "    \"VAL_IMG_DIR = \\\"data/mini_data_val\\\"\\n\",\n",
    "    \"VOCAB_PATH = \\\"data/mini_data/vocab.pkl\\\"\\n\",\n",
    "    \"CHECKPOINT_PATH = f\\\"checkpoints/{MODE}_encoder_best.pth\\\"\\n\",\n",
    "    \"TOPK = 5\\n\",\n",
    "    \"OUTFILE = \\\"retrieval_results.json\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load Vocab & Transform\\n\",\n",
    "    \"with open(VOCAB_PATH, \\\"rb\\\") as f:\\n\",\n",
    "    \"    word2idx = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"transform = transforms.Compose([\\n\",\n",
    "    \"    transforms.Resize((224, 224)),\\n\",\n",
    "    \"    transforms.ToTensor()\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load Dataset\\n\",\n",
    "    \"eval_dataset = RecipeDatasetForEval(\\n\",\n",
    "    \"    json_path=VAL_JSON,\\n\",\n",
    "    \"    image_dir=VAL_IMG_DIR,\\n\",\n",
    "    \"    word2idx=word2idx,\\n\",\n",
    "    \"    transform=transform,\\n\",\n",
    "    \"    mode=MODE\\n\",\n",
    "    \")\\n\",\n",
    "    \"eval_loader = DataLoader(eval_dataset, batch_size=32, shuffle=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load Model\\n\",\n",
    "    \"checkpoint = torch.load(CHECKPOINT_PATH)\\n\",\n",
    "    \"vocab_size = checkpoint['text_encoder']['text_embed.weight'].size(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"image_encoder = ImageEncoder(embed_dim=512).cuda()\\n\",\n",
    "    \"if MODE == \\\"joint\\\":\\n\",\n",
    "    \"    text_encoder = JointEncoderWithCrossAttention(vocab_size=vocab_size, embed_dim=512).cuda()\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    text_encoder = TransformerEncoder(vocab_size=vocab_size, embed_dim=512).cuda()\\n\",\n",
    "    \"\\n\",\n",
    "    \"image_encoder.load_state_dict(checkpoint['image_encoder'])\\n\",\n",
    "    \"text_encoder.load_state_dict(checkpoint['text_encoder'])\\n\",\n",
    "    \"image_encoder.eval()\\n\",\n",
    "    \"text_encoder.eval()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Run Retrieval + Save Results\\n\",\n",
    "    \"run_retrieval_and_save_results(\\n\",\n",
    "    \"    image_encoder=image_encoder,\\n\",\n",
    "    \"    text_encoder=text_encoder,\\n\",\n",
    "    \"    dataloader=eval_loader,\\n\",\n",
    "    \"    dataset=eval_dataset,\\n\",\n",
    "    \"    mode=MODE,\\n\",\n",
    "    \"    topk=TOPK,\\n\",\n",
    "    \"    output_path=OUTFILE,\\n\",\n",
    "    \"    only_failures=False,     # optional - only save failed queries\\n\",\n",
    "    \"\\n\",\n",
    "    \")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"d1a8f392\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# # Optional - show failed retrieval\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# show_retrieval_failures(\\n\",\n",
    "    \"#     retrieval_path=\\\"retrieval_results.json\\\",\\n\",\n",
    "    \"#     dataset_dir=\\\"data/mini_data_val\\\", \\n\",\n",
    "    \"#     num_failures=5\\n\",\n",
    "    \"# )\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"d05de9cb\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# GEMMA prompt for testing/demos/custom prompt runs\\n\",\n",
    "    \"\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"from transformers import AutoTokenizer, AutoModelForCausalLM\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load Gemma Model\\n\",\n",
    "    \"model_name = \\\"google/gemma-2b\\\"\\n\",\n",
    "    \"tokenizer = AutoTokenizer.from_pretrained(model_name)\\n\",\n",
    "    \"model = AutoModelForCausalLM.from_pretrained(model_name, device_map=\\\"auto\\\")\\n\",\n",
    "    \"model.eval()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Generate from Prompt\\n\",\n",
    "    \"def generate_instructions(ingredients, title=None, max_length=256):\\n\",\n",
    "    \"    if title:\\n\",\n",
    "    \"        prompt = f\\\"Recipe Title: {title}\\\\nIngredients: {', '.join(ingredients)}\\\\nInstructions:\\\"\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        prompt = f\\\"Ingredients: {', '.join(ingredients)}\\\\nInstructions:\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    inputs = tokenizer(prompt, return_tensors=\\\"pt\\\").to(model.device)\\n\",\n",
    "    \"    outputs = model.generate(\\n\",\n",
    "    \"        **inputs,\\n\",\n",
    "    \"        max_new_tokens=max_length,\\n\",\n",
    "    \"        do_sample=True,\\n\",\n",
    "    \"        temperature=0.7,\\n\",\n",
    "    \"        top_k=50,\\n\",\n",
    "    \"        top_p=0.95,\\n\",\n",
    "    \"        num_return_sequences=1\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return tokenizer.decode(outputs[0], skip_special_tokens=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Batch Generate from Top-K Retrievals\\n\",\n",
    "    \"def generate_from_topk(topk_json_path, output_path=\\\"generated_topk.json\\\"):\\n\",\n",
    "    \"    with open(topk_json_path, \\\"r\\\") as f:\\n\",\n",
    "    \"        topk_data = json.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    generations = []\\n\",\n",
    "    \"    for entry in topk_data:\\n\",\n",
    "    \"        query_img = entry[\\\"query_image\\\"]\\n\",\n",
    "    \"        for i, candidate in enumerate(entry[\\\"top_recipes\\\"]):\\n\",\n",
    "    \"            ingredients = candidate[\\\"ingredients\\\"]\\n\",\n",
    "    \"            title = candidate.get(\\\"title\\\", \\\"\\\")\\n\",\n",
    "    \"            gen = generate_instructions(ingredients, title)\\n\",\n",
    "    \"            generations.append({\\n\",\n",
    "    \"                \\\"query_image\\\": query_img,\\n\",\n",
    "    \"                \\\"rank\\\": i + 1,\\n\",\n",
    "    \"                \\\"title\\\": title,\\n\",\n",
    "    \"                \\\"ingredients\\\": ingredients,\\n\",\n",
    "    \"                \\\"generated_instructions\\\": gen\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with open(output_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n\",\n",
    "    \"        json.dump(generations, f, indent=2)\\n\",\n",
    "    \"    print(f\\\"Saved {len(generations)} generations to {output_path}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Run\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    generate_from_topk(\\\"retrieval_results.json\\\")\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"2109796d\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Generation Evaluation and Re-Ranking\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"f186d2cc\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# After gemma_gen_topk is being ran\\n\",\n",
    "    \"\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"from nltk.translate.bleu_score import sentence_bleu, SmoothingFunction\\n\",\n",
    "    \"from sentence_transformers import SentenceTransformer, util\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Config\\n\",\n",
    "    \"GENERATED_PATH = \\\"generated_topk.json\\\"\\n\",\n",
    "    \"GROUNDTRUTH_PATH = \\\"data/mini_data_val/val_recipes_stratified.json\\\"\\n\",\n",
    "    \"OUT_PATH = \\\"reranked_generations.json\\\"\\n\",\n",
    "    \"BLEU_WEIGHT = (0.25, 0.25, 0.25, 0.25)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load\\n\",\n",
    "    \"with open(GENERATED_PATH, \\\"r\\\") as f:\\n\",\n",
    "    \"    generated = json.load(f)\\n\",\n",
    "    \"with open(GROUNDTRUTH_PATH, \\\"r\\\") as f:\\n\",\n",
    "    \"    groundtruth = {r[\\\"image\\\"]: r[\\\"instructions\\\"] for r in json.load(f)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Model for cosine similarity\\n\",\n",
    "    \"model = SentenceTransformer(\\\"all-MiniLM-L6-v2\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"results = []\\n\",\n",
    "    \"bleu_scorer = SmoothingFunction().method1\\n\",\n",
    "    \"\\n\",\n",
    "    \"bleu_scores = []\\n\",\n",
    "    \"cosine_scores = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for item in tqdm(generated, desc=\\\"Evaluating and Reranking\\\"):\\n\",\n",
    "    \"    img_id = item[\\\"query_image\\\"]\\n\",\n",
    "    \"    gt_instr = \\\" \\\".join(groundtruth.get(img_id, []))\\n\",\n",
    "    \"    gt_emb = model.encode(gt_instr, convert_to_tensor=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    scored = []\\n\",\n",
    "    \"    for gen in item[\\\"topk_generations\\\"]:\\n\",\n",
    "    \"        gen_text = gen[\\\"generated_instructions\\\"]\\n\",\n",
    "    \"        bleu = sentence_bleu([gt_instr.split()], gen_text.split(), weights=BLEU_WEIGHT, smoothing_function=bleu_scorer)\\n\",\n",
    "    \"        gen_emb = model.encode(gen_text, convert_to_tensor=True)\\n\",\n",
    "    \"        cosine = util.cos_sim(gt_emb, gen_emb).item()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        score = 0.5 * bleu + 0.5 * cosine\\n\",\n",
    "    \"        gen[\\\"bleu\\\"] = bleu\\n\",\n",
    "    \"        gen[\\\"cosine\\\"] = cosine\\n\",\n",
    "    \"        gen[\\\"combined_score\\\"] = score\\n\",\n",
    "    \"        scored.append(gen)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    scored.sort(key=lambda x: x[\\\"combined_score\\\"], reverse=True)\\n\",\n",
    "    \"    results.append({\\n\",\n",
    "    \"        \\\"query_image\\\": img_id,\\n\",\n",
    "    \"        \\\"topk_generations\\\": scored,\\n\",\n",
    "    \"        \\\"best_generation\\\": scored[0] if scored else None\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if scored:\\n\",\n",
    "    \"        bleu_scores.append(scored[0][\\\"bleu\\\"])\\n\",\n",
    "    \"        cosine_scores.append(scored[0][\\\"cosine\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save results\\n\",\n",
    "    \"with open(OUT_PATH, \\\"w\\\") as f:\\n\",\n",
    "    \"    json.dump(results, f, indent=2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Reranked generations with BLEU + Cosine to {OUT_PATH}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Summary Stats\\n\",\n",
    "    \"avg_bleu = sum(bleu_scores) / len(bleu_scores)\\n\",\n",
    "    \"avg_cosine = sum(cosine_scores) / len(cosine_scores)\\n\",\n",
    "    \"print(f\\\"\\\\n📉 Average BLEU: {avg_bleu:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"📉 Average Cosine Similarity: {avg_cosine:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Visualization\\n\",\n",
    "    \"plt.figure(figsize=(8, 5))\\n\",\n",
    "    \"plt.plot(bleu_scores, label=\\\"BLEU Scores\\\")\\n\",\n",
    "    \"plt.plot(cosine_scores, label=\\\"Cosine Similarity\\\")\\n\",\n",
    "    \"plt.title(\\\"Best Generation Scores per Query\\\")\\n\",\n",
    "    \"plt.xlabel(\\\"Query Index\\\")\\n\",\n",
    "    \"plt.ylabel(\\\"Score\\\")\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.grid(True)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(\\\"score_plot.png\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Print Top-5 Samples by BLEU and Cosine\\n\",\n",
    "    \"print(\\\"\\\\n Top 5 by BLEU Score:\\\")\\n\",\n",
    "    \"top_bleu = sorted(results, key=lambda x: x['best_generation']['bleu'], reverse=True)[:5]\\n\",\n",
    "    \"for i, item in enumerate(top_bleu):\\n\",\n",
    "    \"    b = item['best_generation']\\n\",\n",
    "    \"    print(f\\\"{i+1}. {item['query_image']} | BLEU: {b['bleu']:.4f} | Cosine: {b['cosine']:.4f}\\\")\\n\",\n",
    "    \"    print(f\\\"   ↪ {b['generated_instructions'][:100]}...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n Top 5 by Cosine Similarity:\\\")\\n\",\n",
    "    \"top_cosine = sorted(results, key=lambda x: x['best_generation']['cosine'], reverse=True)[:5]\\n\",\n",
    "    \"for i, item in enumerate(top_cosine):\\n\",\n",
    "    \"    b = item['best_generation']\\n\",\n",
    "    \"    print(f\\\"{i+1}. {item['query_image']} | Cosine: {b['cosine']:.4f} | BLEU: {b['bleu']:.4f}\\\")\\n\",\n",
    "    \"    print(f\\\"   ↪ {b['generated_instructions'][:100]}...\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
