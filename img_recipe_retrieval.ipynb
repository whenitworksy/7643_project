    "   \"source\": [\n",
    "    \"import json\\n\",\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import pickle\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load recipes\\n\",\n",
    "    \"with open(\\\"data/mini_data/train_recipes_stratified.json\\\", \\\"r\\\", encoding=\\\"utf-8\\\") as f:\\n\",\n",
    "    \"    recipes = json.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Build vocab from all ingredient words\\n\",\n",
    "    \"counter = Counter()\\n\",\n",
    "    \"for r in recipes:\\n\",\n",
    "    \"    for ing in r[\\\"ingredients\\\"]:\\n\",\n",
    "    \"        tokens = ing.lower().split()\\n\",\n",
    "    \"        counter.update(tokens)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Keep words with at least 2 occurrences\\n\",\n",
    "    \"min_freq = 2\\n\",\n",
    "    \"vocab = [\\\"<pad>\\\", \\\"<unk>\\\"]\\n\",\n",
    "    \"vocab += [word for word, freq in counter.items() if freq >= min_freq]\\n\",\n",
    "    \"\\n\",\n",
    "    \"word2idx = {w: i for i, w in enumerate(vocab)}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save vocab\\n\",\n",
    "    \"with open(\\\"data/mini_data/vocab.pkl\\\", \\\"wb\\\") as f:\\n\",\n",
    "    \"    pickle.dump(word2idx, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Vocab size: {len(word2idx)}\\\")\\n\"\n",
    "   ],\n",
