    "    \"        text_encoder = JointEncoderWithCrossAttention(vocab_size=vocab_size, embed_dim=512).cuda()\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        text_encoder = TransformerEncoder(vocab_size=vocab_size, embed_dim=512).cuda()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    image_encoder.load_state_dict(checkpoint['image_encoder'])\\n\",\n",
    "    \"    text_encoder.load_state_dict(checkpoint['text_encoder'])\\n\",\n",
    "    \"    image_encoder.eval()\\n\",\n",
