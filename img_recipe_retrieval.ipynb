    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-04-26T06:41:12.678242Z\",\n",
    "     \"start_time\": \"2025-04-26T06:41:09.961433Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"from torch.utils.data import Dataset\\n\",\n",
    "    \"from PIL import Image\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"class RecipeDatasetForEval(Dataset):\\n\",\n",
    "    \"    def __init__(self, json_path, image_dir, word2idx, transform, max_len=20, mode='dual'):\\n\",\n",
    "    \"        with open(json_path, 'r', encoding='utf-8') as f:\\n\",\n",
    "    \"            self.data = json.load(f)\\n\",\n",
    "    \"        self.image_dir = Path(image_dir)\\n\",\n",
    "    \"        self.word2idx = word2idx\\n\",\n",
    "    \"        self.transform = transform\\n\",\n",
    "    \"        self.max_len = max_len\\n\",\n",
    "    \"        self.mode = mode\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def tokenize(self, entries):\\n\",\n",
    "    \"        ids = []\\n\",\n",
    "    \"        for e in entries:\\n\",\n",
    "    \"            for tok in e.lower().split():\\n\",\n",
    "    \"                ids.append(self.word2idx.get(tok, self.word2idx['<unk>']))\\n\",\n",
    "    \"        ids = ids[:self.max_len] + [self.word2idx['<pad>']] * (self.max_len - len(ids))\\n\",\n",
    "    \"        return torch.tensor(ids)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __getitem__(self, idx):\\n\",\n",
    "    \"        item = self.data[idx]\\n\",\n",
    "    \"        image_path = self.image_dir / item['image']\\n\",\n",
    "    \"        image = self.transform(Image.open(image_path).convert('RGB'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if self.mode == 'dual':\\n\",\n",
    "    \"            tokens = self.tokenize(item['ingredients'])\\n\",\n",
    "    \"            return image, tokens, idx\\n\",\n",
    "    \"\\n\",\n",
    "    \"        elif self.mode == 'joint':\\n\",\n",
    "    \"            combined = item['ingredients'] + item['instructions']\\n\",\n",
    "    \"            tokens = self.tokenize(combined)\\n\",\n",
    "    \"            return image, tokens\\n\",\n",
    "    \"\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            raise ValueError(\\\"Mode must be either 'dual' or 'joint'\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 10\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"7ddf9f83\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Recall Class module\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"501bf753\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-04-26T06:41:56.912049Z\",\n",
    "     \"start_time\": \"2025-04-26T06:41:56.860281Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn.functional as F\\n\",\n",
    "    \"from torch.utils.data import DataLoader\\n\",\n",
    "    \"from sklearn.metrics import pairwise_distances\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from sklearn.manifold import TSNE\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def compute_recall_at_k_dual(model, dataloader, k_list=[1, 5, 10]):\\n\",\n",
    "    \"    model.eval()\\n\",\n",
    "    \"    all_img_embs, all_txt_embs = [], []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for img, txt, _ in tqdm(dataloader, desc=\\\"Dual Model Eval\\\"):\\n\",\n",
    "    \"        img, txt = img.cuda(), txt.cuda()\\n\",\n",
    "    \"        img_emb, txt_emb = model(img, txt)\\n\",\n",
    "    \"        all_img_embs.append(img_emb)\\n\",\n",
    "    \"        all_txt_embs.append(txt_emb)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    img_matrix = torch.cat(all_img_embs)\\n\",\n",
    "    \"    txt_matrix = torch.cat(all_txt_embs)\\n\",\n",
    "    \"    sims = img_matrix @ txt_matrix.T\\n\",\n",
    "    \"    ranks = sims.argsort(dim=1, descending=True)\\n\",\n",
    "    \"    correct = torch.arange(len(ranks)).unsqueeze(1).to(ranks.device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"    \\\"recalls\\\": {f\\\"Recall@{k}\\\": (ranks[:, :k] == correct).any(dim=1).float().mean().item() for k in k_list},\\n\",\n",
    "    \"    \\\"img_embs\\\": img_matrix,\\n\",\n",
    "    \"    \\\"txt_embs\\\": txt_matrix\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def compute_recall_at_k_joint(image_encoder, text_encoder, dataloader, k_list=[1, 5, 10]):\\n\",\n",
    "    \"    image_encoder.eval()\\n\",\n",
    "    \"    text_encoder.eval()\\n\",\n",
    "    \"    all_img_embs, all_txt_embs = [], []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for img, txt in tqdm(dataloader, desc=\\\"Joint Encoder Eval\\\"):\\n\",\n",
    "    \"        img, txt = img.cuda(), txt.cuda()\\n\",\n",
    "    \"        img_emb = image_encoder(img)\\n\",\n",
    "    \"        txt_emb = text_encoder(img_emb, txt)\\n\",\n",
    "    \"        all_img_embs.append(img_emb)\\n\",\n",
    "    \"        all_txt_embs.append(txt_emb)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    img_matrix = torch.cat(all_img_embs)\\n\",\n",
    "    \"    txt_matrix = torch.cat(all_txt_embs)\\n\",\n",
    "    \"    sims = img_matrix @ txt_matrix.T\\n\",\n",
    "    \"    ranks = sims.argsort(dim=1, descending=True)\\n\",\n",
    "    \"    correct = torch.arange(len(ranks)).unsqueeze(1).to(ranks.device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"    \\\"recalls\\\": {f\\\"Recall@{k}\\\": (ranks[:, :k] == correct).any(dim=1).float().mean().item() for k in k_list},\\n\",\n",
    "    \"    \\\"img_embs\\\": img_matrix,\\n\",\n",
    "    \"    \\\"txt_embs\\\": txt_matrix\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def visualize_embeddings(img_embs, txt_embs):\\n\",\n",
    "    \"    all_embs = torch.cat([img_embs, txt_embs], dim=0).cpu().numpy()\\n\",\n",
    "    \"    labels = [\\\"Image\\\"] * img_embs.size(0) + [\\\"Text\\\"] * txt_embs.size(0)\\n\",\n",
    "    \"    tsne = TSNE(n_components=2, perplexity=30)\\n\",\n",
    "    \"    reduced = tsne.fit_transform(all_embs)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.figure(figsize=(10, 7))\\n\",\n",
    "    \"    sns.scatterplot(x=reduced[:, 0], y=reduced[:, 1], hue=labels, alpha=0.7)\\n\",\n",
    "    \"    plt.title(\\\"t-SNE of Joint Embeddings\\\")\\n\",\n",
    "    \"    plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 13\n",
    "  },\n",
