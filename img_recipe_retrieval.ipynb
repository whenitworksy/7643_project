    "   },\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn.functional as F\\n\",\n",
    "    \"from torch.utils.data import DataLoader\\n\",\n",
    "    \"from torchvision import transforms\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import json, pickle, random\\n\",\n",
    "    \"from PIL import Image\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"from multimodal_encoder import ImageEncoder, JointEncoderWithCrossAttention, TransformerEncoder, BertIngredientEncoder\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"torch.manual_seed(42)\\n\",\n",
    "    \"np.random.seed(42)\\n\",\n",
    "    \"random.seed(42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Config\\n\",\n",
    "    \"BATCH_SIZE = 64\\n\",\n",
    "    \"EPOCHS = 5\\n\",\n",
    "    \"EMBED_DIM = 256\\n\",\n",
    "    \"LR = 5e-5\\n\",\n",
    "    \"WGT_DECAY = 3e-5\\n\",\n",
    "    \"DROPOUT_RATE = 0.5\\n\",\n",
    "    \"HARD_NGTV_EPS = 0.05\\n\",\n",
    "    \"TEMPERATURE = 0.05\\n\",\n",
    "    \"VISION_ENCODER_NAME = 'resnet50'        # 'resnet18', 'resnet50', 'vit_b_16', 'efficientnet_b0'\\n\",\n",
    "    \"VISION_TUNE_LAST_N_BLOCK = 0           # set to 0 unless wish to fine-tune pre-trained vision encoder\\n\",\n",
    "    \"CHECKPOINT_PATH = \\\"checkpoints\\\"\\n\",\n",
    "    \"os.makedirs(CHECKPOINT_PATH, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Dataset\\n\",\n",
    "    \"class HardNegativeDataset(torch.utils.data.Dataset):\\n\",\n",
    "    \"    def __init__(self, json_path, image_dir, word2idx, transform, max_len=20, mode=\\\"joint\\\",hard_negatives=None):\\n\",\n",
    "    \"        with open(json_path, \\\"r\\\") as f:\\n\",\n",
    "    \"            self.data = json.load(f)\\n\",\n",
    "    \"        self.image_dir = Path(image_dir)\\n\",\n",
    "    \"        self.word2idx = word2idx\\n\",\n",
    "    \"        self.transform = transform\\n\",\n",
    "    \"        self.max_len = max_len\\n\",\n",
    "    \"        self.mode = mode\\n\",\n",
    "    \"        self.hard_negatives = hard_negatives\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def tokenize(self, texts):\\n\",\n",
    "    \"        ids = []\\n\",\n",
    "    \"        for t in texts:\\n\",\n",
    "    \"            for token in t.lower().split():\\n\",\n",
    "    \"                ids.append(self.word2idx.get(token, self.word2idx[\\\"<unk>\\\"]))\\n\",\n",
    "    \"        ids = ids[:self.max_len] + [self.word2idx['<pad>']] * (self.max_len - len(ids))\\n\",\n",
    "    \"        return torch.tensor(ids)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __getitem__(self, idx):\\n\",\n",
    "    \"        anchor = self.data[idx]\\n\",\n",
    "    \"        image = self.transform(Image.open(self.image_dir / anchor[\\\"image\\\"]).convert(\\\"RGB\\\"))\\n\",\n",
    "    \"        pos = self.tokenize(anchor[\\\"ingredients\\\"] + anchor[\\\"instructions\\\"]) if self.mode == \\\"joint\\\" else self.tokenize(anchor[\\\"ingredients\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # HARD NEGATIVE MINING (if available)\\n\",\n",
    "    \"        if self.hard_negatives is not None:\\n\",\n",
    "    \"            neg_idx = self.hard_negatives[idx]\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            # fallback to random or semi-hard\\n\",\n",
    "    \"            anchor_ingr = anchor[\\\"ingredients\\\"][0].lower().split()[0]\\n\",\n",
    "    \"            neg_idx = next((i for i in range(len(self.data)) if i != idx and anchor_ingr in self.data[i][\\\"ingredients\\\"][0].lower()), idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        neg = self.tokenize(self.data[neg_idx][\\\"ingredients\\\"] + self.data[neg_idx][\\\"instructions\\\"]) if self.mode == \\\"joint\\\" else self.tokenize(self.data[neg_idx][\\\"ingredients\\\"])\\n\",\n",
    "    \"        return image, pos, neg\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Triplet Loss\\n\",\n",
    "    \"def triplet_loss(anchor, positive, negative, margin=0.2):\\n\",\n",
    "    \"    # return torch.clamp(margin + F.cosine_similarity(anchor, negative) - F.cosine_similarity(anchor, positive), min=0).mean()      # hinge version - clear separation but has hard threshold at 0\\n\",\n",
    "    \"    return F.softplus(F.cosine_similarity(anchor, negative) - F.cosine_similarity(anchor, positive) + margin).mean()                # softer version - loss is always +ve and non-zero gradient (better for noisy or smaller dataset)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def info_nce_loss(image_embs, text_embs, temperature=0.07):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Compute symmetric InfoNCE loss for joint image-text embeddings.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        image_embs: [B, D] image embeddings\\n\",\n",
    "    \"        text_embs:  [B, D] text embeddings\\n\",\n",
    "    \"        temperature: scaling factor (typically 0.05 to 0.1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        Symmetric contrastive loss\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Normalize to unit vectors (important for cosine sim)\\n\",\n",
    "    \"    image_embs = F.normalize(image_embs, dim=1)\\n\",\n",
    "    \"    text_embs = F.normalize(text_embs, dim=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Cosine similarity matrix [B, B]\\n\",\n",
    "    \"    logits_per_image = image_embs @ text_embs.T / temperature\\n\",\n",
    "    \"    logits_per_text = text_embs @ image_embs.T / temperature\\n\",\n",
    "    \"\\n\",\n",
    "    \"    labels = torch.arange(image_embs.size(0), device=image_embs.device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Cross entropy loss\\n\",\n",
    "    \"    loss_i2t = F.cross_entropy(logits_per_image, labels)\\n\",\n",
    "    \"    loss_t2i = F.cross_entropy(logits_per_text, labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return (loss_i2t + loss_t2i) / 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_sim_matrix_batched(embs, batch_size=512):\\n\",\n",
    "    \"    embs = embs.cpu()\\n\",\n",
    "    \"    N = embs.size(0)\\n\",\n",
    "    \"    sim_matrix = torch.empty((N, N))\\n\",\n",
    "    \"    for i in tqdm(range(0, N, batch_size), desc=\\\"Chunked sim_matrix\\\"):\\n\",\n",
    "    \"        i_end = min(i + batch_size, N)\\n\",\n",
    "    \"        for j in range(0, N, batch_size):\\n\",\n",
    "    \"            j_end = min(j + batch_size, N)\\n\",\n",
    "    \"            sim = F.cosine_similarity(\\n\",\n",
    "    \"                embs[i:i_end].unsqueeze(1),\\n\",\n",
    "    \"                embs[j:j_end].unsqueeze(0),\\n\",\n",
    "    \"                dim=-1\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"            sim_matrix[i:i_end, j:j_end] = sim\\n\",\n",
    "    \"    return sim_matrix\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def mine_hard_negatives(image_encoder, text_encoder, dataset, batch_size=64, device=\\\"cuda\\\", k=10, mode=\\\"joint\\\", epsilon=0.05):\\n\",\n",
    "    \"    image_encoder.eval()\\n\",\n",
    "    \"    text_encoder.eval()\\n\",\n",
    "    \"    dataloader = DataLoader(dataset, batch_size=batch_size, shuffle=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    img_embs, txt_embs = [], []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        for img, pos, _ in tqdm(dataloader, desc=\\\"Mining Embeddings\\\"):\\n\",\n",
    "    \"            img, pos = img.to(device), pos.to(device)\\n\",\n",
    "    \"            img_emb = image_encoder(img)\\n\",\n",
    "    \"            if mode == \\\"joint\\\":\\n\",\n",
    "    \"                txt_emb = text_encoder(img_emb, pos)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                txt_emb = text_encoder(pos)\\n\",\n",
    "    \"            img_embs.append(img_emb.cpu())\\n\",\n",
    "    \"            txt_embs.append(txt_emb.cpu())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    img_embs = torch.cat(img_embs)  # [N, D]\\n\",\n",
    "    \"    txt_embs = torch.cat(txt_embs)  # [N, D]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    N = len(txt_embs)\\n\",\n",
    "    \"    CHUNK_SIZE = 256  # lower if needed\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if mode == \\\"dual\\\":\\n\",\n",
    "    \"        sim_matrix = []\\n\",\n",
    "    \"        for i in tqdm(range(0, N, CHUNK_SIZE), desc=\\\"Computing sim_matrix\\\"):\\n\",\n",
    "    \"            chunk = img_embs[i:i+CHUNK_SIZE].to(device)     # image queries\\n\",\n",
    "    \"            ref = txt_embs.to(device)                       # all text candidates\\n\",\n",
    "    \"            sims = F.cosine_similarity(chunk.unsqueeze(1), ref.unsqueeze(0), dim=-1)  # [C, N]\\n\",\n",
    "    \"            sim_matrix.append(sims.cpu())\\n\",\n",
    "    \"        sim_matrix = torch.cat(sim_matrix, dim=0)           # [N, N]\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        sim_matrix = []\\n\",\n",
    "    \"        txt_embs_cpu = txt_embs.cpu()  # ensure full embeddings are on CPU\\n\",\n",
    "    \"        for i in tqdm(range(0, N, CHUNK_SIZE), desc=\\\"Computing sim_matrix\\\"):\\n\",\n",
    "    \"            chunk = txt_embs_cpu[i:i+CHUNK_SIZE]  # already on CPU\\n\",\n",
    "    \"            ref = txt_embs_cpu  # already on CPU\\n\",\n",
    "    \"            sims = F.cosine_similarity(chunk.unsqueeze(1), ref.unsqueeze(0), dim=-1)  # [C, N]\\n\",\n",
    "    \"            sim_matrix.append(sims)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        sim_matrix = torch.cat(sim_matrix, dim=0)  # [N, N]\\n\",\n",
    "    \"    sim_matrix.fill_diagonal_(-1e9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Semi-hard selection: Not closest, not too easy\\n\",\n",
    "    \"    hard_negatives = []\\n\",\n",
    "    \"    for i in range(N):\\n\",\n",
    "    \"        if mode == \\\"dual\\\":\\n\",\n",
    "    \"            pos_sim = F.cosine_similarity(img_embs[i].unsqueeze(0), txt_embs[i].unsqueeze(0), dim=-1).item()\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            pos_sim = F.cosine_similarity(txt_embs[i].unsqueeze(0), img_embs[i].unsqueeze(0), dim=-1).item()\\n\",\n",
    "    \"        candidates = sim_matrix[i]\\n\",\n",
    "    \"        semi_hard_mask = (candidates < pos_sim) & (candidates > pos_sim - epsilon)\\n\",\n",
    "    \"        valid = torch.nonzero(semi_hard_mask).squeeze(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(valid) == 0:\\n\",\n",
    "    \"            # fallback to random if no semi-hard found\\n\",\n",
    "    \"            neg_idx = random.choice([j for j in range(N) if j != i])\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            neg_idx = valid[torch.randint(0, len(valid), (1,))].item()\\n\",\n",
    "    \"        hard_negatives.append(neg_idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return hard_negatives\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train Dual or Joint\\n\",\n",
    "    \"def train(mode=\\\"joint\\\", dropout=0.1, eval_loader=None, temperature=0.07):\\n\",\n",
    "    \"    with open(\\\"data/mini_data/vocab.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"        word2idx = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # train_transform = transforms.Compose([\\n\",\n",
    "    \"    #     transforms.Resize((224, 224)),\\n\",\n",
    "    \"    #     transforms.ToTensor(),\\n\",\n",
    "    \"    # ])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    best_recall1 = 0.0\\n\",\n",
    "    \"    best_model_state = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Data augmentation on training set only to combat overfitting (can switch to easy one like above)\\n\",\n",
    "    \"    train_transform = transforms.Compose([\\n\",\n",
    "    \"        transforms.Resize(256),\\n\",\n",
    "    \"        transforms.RandomResizedCrop(224),\\n\",\n",
    "    \"        transforms.RandomHorizontalFlip(),\\n\",\n",
    "    \"        transforms.ColorJitter(brightness=0.1, contrast=0.1),\\n\",\n",
    "    \"        transforms.ToTensor(),\\n\",\n",
    "    \"    ])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dataset = HardNegativeDataset(\\\"data/mini_data/train_recipes_stratified.json\\\", \\\"data/mini_data\\\", word2idx, train_transform, mode=mode)\\n\",\n",
    "    \"    dataloader = DataLoader(\\n\",\n",
    "    \"                    dataset, \\n\",\n",
    "    \"                    batch_size=BATCH_SIZE, \\n\",\n",
    "    \"                    shuffle=True, \\n\",\n",
    "    \"                    drop_last=True,\\n\",\n",
    "    \"                    num_workers=0,          # adjust based on CPU cores\\n\",\n",
    "    \"                    pin_memory=True        # speeds up host-to-GPU transfers\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Check to see if eval_loader is present\\n\",\n",
    "    \"    if eval_loader is None:\\n\",\n",
    "    \"        raise ValueError(\\\"eval_loader must be provided\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    image_encoder = ImageEncoder(\\n\",\n",
    "    \"                                embed_dim=EMBED_DIM,\\n\",\n",
    "    \"                                model_name=VISION_ENCODER_NAME,\\n\",\n",
    "    \"                                tune_last_n_blocks=VISION_TUNE_LAST_N_BLOCK,\\n\",\n",
    "    \"                                dropout=dropout\\n\",\n",
    "    \"                            ).cuda()\\n\",\n",
    "    \"    # Print trainable parameters for vision encoders\\n\",\n",
    "    \"    image_encoder.print_trainable_layers()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if mode == \\\"joint\\\":\\n\",\n",
    "    \"        text_encoder = JointEncoderWithCrossAttention(vocab_size=len(word2idx), embed_dim=EMBED_DIM, dropout=dropout).cuda()\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        text_encoder = TransformerEncoder(vocab_size=len(word2idx), embed_dim=EMBED_DIM, dropout=dropout).cuda()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    optimizer = torch.optim.AdamW(list(image_encoder.parameters()) + list(text_encoder.parameters()), lr=LR, weight_decay=WGT_DECAY)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    all_losses = []\\n\",\n",
    "    \"    all_recalls = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for epoch in range(EPOCHS):\\n\",\n",
    "    \"        if epoch > 0 and epoch % 1 == 0:       # adjust frequency of hard negative mining\\n\",\n",
    "    \"            print(\\\"Re-mining hard negatives...\\\")\\n\",\n",
    "    \"            # mine top 10 hard negatives then random sample as opposed to just top 1 for stability\\n\",\n",
    "    \"            dataset.hard_negatives = mine_hard_negatives(image_encoder, text_encoder, dataset, k=10, mode=mode, epsilon=HARD_NGTV_EPS)       \\n\",\n",
    "    \"            # pass\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        image_encoder.train()\\n\",\n",
    "    \"        text_encoder.train()\\n\",\n",
    "    \"        total_loss = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for batch_idx, (img, pos, neg) in enumerate(tqdm(dataloader, desc=f\\\"Epoch {epoch+1}\\\")):\\n\",\n",
    "    \"            img, pos, neg = img.cuda(), pos.cuda(), neg.cuda()\\n\",\n",
    "    \"            img_emb = image_encoder(img)\\n\",\n",
    "    \"            if mode == \\\"joint\\\":\\n\",\n",
    "    \"                pos_emb = text_encoder(img_emb, pos)\\n\",\n",
    "    \"                neg_emb = text_encoder(img_emb, neg)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                pos_emb = text_encoder(pos)\\n\",\n",
    "    \"                neg_emb = text_encoder(neg)\\n\",\n",
    "    \"            # Debug print - can be removed later (to see how wide should be set on triplet loss margin)\\n\",\n",
    "    \"            if batch_idx % 50 == 0:  # Only print every 50 steps\\n\",\n",
    "    \"                with torch.no_grad():\\n\",\n",
    "    \"                    cos_pos = F.cosine_similarity(img_emb, pos_emb)\\n\",\n",
    "    \"                    cos_neg = F.cosine_similarity(img_emb, neg_emb)\\n\",\n",
    "    \"                    print(f\\\"[Epoch {epoch+1} | Step {batch_idx}] avg_cos_pos={cos_pos.mean():.4f} | avg_cos_neg={cos_neg.mean():.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"            loss = info_nce_loss(img_emb, pos_emb, temperature=temperature)  # assuming pos_emb is the paired text embeddings\\n\",\n",
    "    \"            optimizer.zero_grad()\\n\",\n",
    "    \"            loss.backward()\\n\",\n",
    "    \"            optimizer.step()\\n\",\n",
    "    \"            total_loss += loss.item()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        avg_loss = total_loss / len(dataloader)\\n\",\n",
    "    \"        all_losses.append(avg_loss)\\n\",\n",
    "    \"        print(f\\\"Epoch {epoch+1}: Loss = {avg_loss:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Evaluate Recall@K\\n\",\n",
    "    \"        if mode == \\\"joint\\\":\\n\",\n",
    "    \"            recall = compute_recall_at_k_joint(image_encoder, text_encoder, eval_loader)\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            class DualWrapper(torch.nn.Module):\\n\",\n",
    "    \"                def __init__(self, img_enc, txt_enc):\\n\",\n",
    "    \"                    super().__init__()\\n\",\n",
    "    \"                    self.img_enc = img_enc\\n\",\n",
    "    \"                    self.txt_enc = txt_enc\\n\",\n",
    "    \"                def forward(self, img, txt):\\n\",\n",
    "    \"                    return self.img_enc(img), self.txt_enc(txt)\\n\",\n",
    "    \"            recall = compute_recall_at_k_dual(DualWrapper(image_encoder, text_encoder), eval_loader)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        all_recalls.append(recall)\\n\",\n",
    "    \"        print(f\\\"Epoch {epoch+1} Recall@K: {recall}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # only print chart of TSNE embedding visualization (can be commented out)\\n\",\n",
    "    \"        if (epoch + 1) % 5 == 0:\\n\",\n",
    "    \"            if isinstance(recall, dict) and \\\"img_embs\\\" in recall:\\n\",\n",
    "    \"                visualize_embeddings(recall[\\\"img_embs\\\"], recall[\\\"txt_embs\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Save current model every epoch\\n\",\n",
    "    \"        epoch_ckpt_path = Path(CHECKPOINT_PATH) / f\\\"{mode}_encoder_epoch{epoch+1}.pth\\\"\\n\",\n",
    "    \"        torch.save({\\n\",\n",
    "    \"            'image_encoder': image_encoder.state_dict(),\\n\",\n",
    "    \"            'text_encoder': text_encoder.state_dict(),\\n\",\n",
    "    \"            'config': {\\n\",\n",
    "    \"                'mode': mode,\\n\",\n",
    "    \"                'model_name': VISION_ENCODER_NAME,\\n\",\n",
    "    \"                'tune_last_n_blocks': VISION_TUNE_LAST_N_BLOCK,\\n\",\n",
    "    \"                'embed_dim': EMBED_DIM,\\n\",\n",
    "    \"                'temperature': temperature\\n\",\n",
    "    \"            }\\n\",\n",
    "    \"        }, epoch_ckpt_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Save best model based on Recall@1\\n\",\n",
    "    \"        curr_recall1 = recall[\\\"recalls\\\"][\\\"Recall@1\\\"]\\n\",\n",
    "    \"        if curr_recall1 > best_recall1:\\n\",\n",
    "    \"            best_recall1 = curr_recall1\\n\",\n",
    "    \"            best_model_state = {\\n\",\n",
    "    \"                'epoch': epoch + 1,\\n\",\n",
    "    \"                'image_encoder': image_encoder.state_dict(),\\n\",\n",
    "    \"                'text_encoder': text_encoder.state_dict(),\\n\",\n",
    "    \"                'optimizer': optimizer.state_dict(),\\n\",\n",
    "    \"                'config': {\\n\",\n",
    "    \"                    'mode': mode,\\n\",\n",
    "    \"                    'model_name': VISION_ENCODER_NAME,\\n\",\n",
    "    \"                    'tune_last_n_blocks': VISION_TUNE_LAST_N_BLOCK,\\n\",\n",
    "    \"                    'embed_dim': EMBED_DIM,\\n\",\n",
    "    \"                    'temperature': temperature\\n\",\n",
    "    \"                },\\n\",\n",
    "    \"                'best_recall1': best_recall1\\n\",\n",
    "    \"            }\\n\",\n",
    "    \"            torch.save(best_model_state, Path(CHECKPOINT_PATH) / f\\\"{mode}_encoder_best.pth\\\")\\n\",\n",
    "    \"            print(f\\\"[Epoch {epoch+1}] best model saved - Recall@1 = {best_recall1:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot Loss\\n\",\n",
    "    \"    plt.figure()\\n\",\n",
    "    \"    plt.plot(range(1, EPOCHS+1), all_losses, label=\\\"Loss\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Epoch\\\")\\n\",\n",
    "    \"    plt.ylabel(\\\"Loss\\\")\\n\",\n",
    "    \"    plt.title(\\\"Training Loss Over Epochs\\\")\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.savefig(f\\\"{mode}_loss_plot.png\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot Recall@K\\n\",\n",
    "    \"    for k in [1, 5, 10]:\\n\",\n",
    "    \"        plt.plot([r[\\\"recalls\\\"][f\\\"Recall@{k}\\\"] for r in all_recalls], label=f\\\"Recall@{k}\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Epoch\\\")\\n\",\n",
    "    \"    plt.ylabel(\\\"Recall\\\")\\n\",\n",
    "    \"    plt.title(\\\"Recall@K Over Epochs\\\")\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.savefig(f\\\"{mode}_recall_plot.png\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    with open(\\\"data/mini_data/vocab.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"        word2idx = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    val_transform = transforms.Compose([\\n\",\n",
    "    \"        transforms.Resize((224, 224)),\\n\",\n",
    "    \"        transforms.ToTensor(),\\n\",\n",
    "    \"    ])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    eval_dataset = RecipeDatasetForEval(\\\"data/mini_data_val/val_recipes_stratified.json\\\", \\\"data/mini_data_val\\\", word2idx, val_transform, mode=\\\"joint\\\")\\n\",\n",
    "    \"    eval_loader = DataLoader(eval_dataset, batch_size=32, shuffle=False)\\n\",\n",
    "    \"    train(mode=\\\"joint\\\", dropout=DROPOUT_RATE, eval_loader=eval_loader, temperature=TEMPERATURE)        # or train(mode=\\\"dual\\\")\\n\"\n",
